# =========================================================
# BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Sao chép file này thành .env và điền các giá trị thực tế
# =========================================================

# --- CẤU HÌNH SERVER ---
PORT=5000
NODE_ENV=development
DOCUMENT_PATH=./DOCUMENT

# --- CẤU HÌNH DATABASE (MONGODB) ---
MONGO_URI=mongodb://127.0.0.1:27017/BAN_HANG_GIA_DUNG

# --- CẤU HÌNH CORS (CLIENT URLS) ---
CLIENT_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# --- CẤU HÌNH XÁC THỰC & BẢO MẬT (AUTH / JWT) ---
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# --- TÀI KHOẢN ADMIN MẶC ĐỊNH ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123456

# --- CẤU HÌNH GỬI EMAIL OTP (GMAIL SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM="Website Gia Dụng" <your_email@gmail.com>

# --- GOOGLE GEMINI AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- CLOUDINARY (Upload avatar) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- CỔNG THANH TOÁN (PAYMENT GATEWAYS) ---
PAYMENT_ENV=sandbox

# 1. VNPay
VNP_TMN_CODE=SANDBOX_TMN_CODE
VNP_HASH_SECRET=SANDBOX_HASH_SECRET
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
VNP_IPN_URL=http://localhost:5000/api/payments/vnpay/ipn

# 2. MoMo
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_REDIRECT_URL=http://localhost:5173/payment/result
MOMO_IPN_URL=http://localhost:5000/api/payments/momo/ipn

# 3. ZaloPay
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sandbox.zalopay.com.vn

# 4. Chuyển khoản ngân hàng (Manual Bank Transfer)
BANK_NAME=Vietcombank
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_HOLDER=CONG TY GIA DUNG MAU
